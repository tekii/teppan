#!/usr/bin/env bash
# reference-transaction -- B3 accidental-HEAD-move backstop (git hook).
#
# Aborts ref updates that move the SHARED main checkout's HEAD / current branch
# from inside the container, unless the sanctioned integrator opts in with
# TEPPAN_MAIN_HEAD_OK=1. Runs inside git's ref machinery, so it catches the
# scripted / plumbing routes the PreToolUse deny (command-string match) can't see.
#
# Scope: ACCIDENTAL only. A compromised/injected agent can bypass it (disable the
# hook, write .git/HEAD directly, unset the marker); that threat model needs
# capability removal (B2 / read-only mount), not this hook. See
# knowledge/notes/parallel-agent-worktrees.md (the guard section).
#
# Coverage (empirically validated on git 2.43 -- see the note's guard section):
#   CATCHES (aborts the ref move): reset, commit, merge, detached checkout,
#     branch force-move/delete, update-ref  (ref == HEAD or refs/heads/<current>).
#   CANNOT SEE: `git checkout|switch <branch>` -- retargeting the HEAD symref emits
#     NO ref transaction. The post-checkout hook covers that route (detective).
#   TOO LATE for worktree state: `git reset --hard` rewrites the index+worktree
#     BEFORE this fires, so an abort preserves HEAD but leaves the tree reverted
#     (recover with: git restore --source=HEAD --staged --worktree .).
#
# Fail-open on the host: this file lives in the SHARED .git/hooks, so host git
# runs it too. The FIRST line exits 0 when the container marker is absent, with
# no git call, so a bug here can never disrupt host git operations.
set -uo pipefail
[ "${TEPPAN_IN_CONTAINER:-}" = 1 ] || exit 0     # host / non-container -> allow (first, no git)
[ "${1:-}" = prepared ] || exit 0                # only the abortable phase
[ "${TEPPAN_MAIN_HEAD_OK:-}" = 1 ] && exit 0     # sanctioned integrator override (inline only)

# Main worktree only -- a linked worktree moving its OWN HEAD is always allowed.
gitdir=$(git rev-parse --absolute-git-dir 2>/dev/null)                       || exit 0
common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)  || exit 0
[ "$gitdir" = "$common" ] || exit 0

cur=$(git symbolic-ref --quiet HEAD 2>/dev/null || true)   # refs/heads/master; empty if detached
while read -r _old new ref; do
  # Skip symref writes (new = "ref:refs/..."). These are worktree-init side
  # effects (git 2.55's `git worktree add` writes a `ref:` HEAD in the MAIN
  # git-dir -- blocking it would break provisioning) or a plain HEAD retarget;
  # neither reverts the working tree. The file-reverting HEAD moves
  # (git checkout|switch <branch>) never reach this hook at all. Only real
  # object-id moves of HEAD / the current branch (reset, commit, merge, detached
  # checkout) are the accidents worth aborting.
  case "$new" in ref:*) continue ;; esac
  if [ "$ref" = HEAD ] || { [ -n "$cur" ] && [ "$ref" = "$cur" ]; }; then
    {
      echo "B3 guard: refusing to move the SHARED main checkout's HEAD from a container session."
      echo "  Work in your own sibling worktree, never in the shared checkout."
      echo "  Sanctioned integrator override: TEPPAN_MAIN_HEAD_OK=1 <git cmd>"
    } >&2
    exit 1
  fi
done
exit 0
