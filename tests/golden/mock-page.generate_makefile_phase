
## +++++++++++++++++++++++++++ ##
## page-a MAKEFILE BEGINS (es) ##
## +++++++++++++++++++++++++++ ##
# NAVIGATION
$(BUILD_ROOT)/NAV/mock-a.test/page-a.m4 : @SRC@/generator.m4
$(BUILD_ROOT)/NAV/mock-a.test/page-a.m4 : EXTRA_NAV_FLAGS+= -D __LANG__=es -D __STEM__=page-a -D __LOCAL_URL_ID__=__MOCK-A_TEST_PAGE-A_ES_URL__
$(BUILD_ROOT)/NAV/mock-a.test/page-a.m4 : @SRC@/tests/fixtures/mock-page.in.html | $$(@D)/ ; $(do-generate-navigation)
navigation-files-clean :: ; @test -f $(BUILD_ROOT)/NAV/mock-a.test/page-a.m4 && rm $(BUILD_ROOT)/NAV/mock-a.test/page-a.m4 || true
.SECONDARY: $(BUILD_ROOT)/NAV/mock-a.test/page-a.m4
$(BUILD_ROOT)/NAV/mock-a.test/NAVIGATION.m4 : $(BUILD_ROOT)/NAV/mock-a.test/page-a.m4
navigation-files-clean :: ; @test -f $(BUILD_ROOT)/NAV/mock-a.test/NAVIGATION.m4 && rm $(BUILD_ROOT)/NAV/mock-a.test/NAVIGATION.m4 || true
# LANDING -- separate fragment/phase from NAVIGATION above: the NAVIGATION
# fragment carries this domain's whole NAVIGATION diversion (nav-menu
# items, every page's URL macro on this domain); reusing it for the
# cross-domain NAVIGATION-LANDING.m4 aggregate would leak all of that into
# every other domain that includes NAVIGATION-LANDING.m4.
$(BUILD_ROOT)/NAV/mock-a.test/page-a.landing.m4 : @SRC@/generator.m4
$(BUILD_ROOT)/NAV/mock-a.test/page-a.landing.m4 : EXTRA_LANDING_FLAGS+= -D __LANG__=es -D __STEM__=page-a -D __LOCAL_URL_ID__=__MOCK-A_TEST_PAGE-A_ES_URL__
$(BUILD_ROOT)/NAV/mock-a.test/page-a.landing.m4 : @SRC@/tests/fixtures/mock-page.in.html | $$(@D)/ ; $(do-generate-landing)
navigation-files-clean :: ; @test -f $(BUILD_ROOT)/NAV/mock-a.test/page-a.landing.m4 && rm $(BUILD_ROOT)/NAV/mock-a.test/page-a.landing.m4 || true
$(BUILD_ROOT)/NAV/NAVIGATION-LANDING.m4 : $(BUILD_ROOT)/NAV/mock-a.test/page-a.landing.m4
navigation-files-clean :: ; @test -f $(BUILD_ROOT)/NAV/NAVIGATION-LANDING.m4 && rm $(BUILD_ROOT)/NAV/NAVIGATION-LANDING.m4 || true
# FIREBASE PUB FRAGMENT (GENERATE_PUBLISH_PHASE run for this landing stem)
$(BUILD_ROOT)/PUB/mock-a.test.json : @SRC@/generator.m4
$(BUILD_ROOT)/PUB/mock-a.test.json : EXTRA_PUBLISH_FLAGS+= -D __DOMAIN__=mock-a.test -D __LANG__=es -D __STEM__=page-a -D __LOCAL_URL_ID__=__MOCK-A_TEST_PAGE-A_ES_URL__
$(BUILD_ROOT)/PUB/mock-a.test.json : @SRC@/tests/fixtures/mock-page.in.html | $$(@D)/ ; $(do-generate-publish)
publish-files-clean :: ; @test -f $(BUILD_ROOT)/PUB/mock-a.test.json && rm $(BUILD_ROOT)/PUB/mock-a.test.json || true
$(BUILD_ROOT)/firebase.json : $(BUILD_ROOT)/PUB/mock-a.test.json
build : $(BUILD_ROOT)/firebase.json
# PER-DOMAIN PUBLISH + REFUSE-ONLY MODE GUARD (see BUILD MODE STAMP, Makefile)
# guard reads the stamp only -- publish never builds (Devon decision, 2026-07-23)
.PHONY : mock-a-test-publish mock-a-test-mode-guard
mock-a-test-mode-guard : ; @test "$$(cat $(BUILD_ROOT)/.mode-mock-a.test 2>/dev/null)" = "build" || { echo "*** mock-a.test not built in build mode -- run 'make build' first"; exit 1; }
mock-a-test-publish : mock-a-test-mode-guard $(BUILD_ROOT)/firebase.json ; $(do-firebase-deploy-only)
publish : mock-a-test-mode-guard
# HTML
# $(BUILD_ROOT)/DOC/mock-a.test/page-a.html : $(BUILD_ROOT)/NAV/mock-a.test/NAVIGATION.m4
$(BUILD_ROOT)/DOC/mock-a.test/page-a.html : @SRC@/tests/fixtures/mock-layout.html
$(BUILD_ROOT)/DOC/mock-a.test/page-a.html : @SRC@/generator.m4
$(BUILD_ROOT)/DOC/mock-a.test/page-a.html : $(BUILD_ROOT)/.mode-mock-a.test
$(BUILD_ROOT)/DOC/mock-a.test/page-a.html : EXTRA_HTML_FLAGS+= -D __LAYOUT__=@SRC@/tests/fixtures/mock-layout.html -D __DOMAIN__=mock-a.test -D __LANG__=es -D __STEM__=page-a -D __LOCAL_URL_ID__=__MOCK-A_TEST_PAGE-A_ES_URL__ -D __ROOT__=$(BUILD_ROOT)/DOC/mock-a.test -D __VENDOR__=@SRC@/tests/fixtures/MOCK_VENDOR
$(BUILD_ROOT)/DOC/mock-a.test/page-a.html : @SRC@/tests/fixtures/mock-page.in.html | $$(@D)/ $(BUILD_ROOT)/NAV/mock-a.test/NAVIGATION.m4 $(BUILD_ROOT)/NAV/NAVIGATION-LANDING.m4 ; $(do-generate-html)
build-clean :: ; @test -f $(BUILD_ROOT)/DOC/mock-a.test/page-a.html && rm $(BUILD_ROOT)/DOC/mock-a.test/page-a.html || true
# DEFERRED MAKEFILE
$(BUILD_ROOT)/DOC/mock-a.test/page-a.mk : @SRC@/generator.m4
$(BUILD_ROOT)/DOC/mock-a.test/page-a.mk : EXTRA_DEFERRED_MK_FLAGS+=  -D __LAYOUT__=@SRC@/tests/fixtures/mock-layout.html -D __DOMAIN__=mock-a.test -D __LANG__=es -D __STEM__=page-a -D __LOCAL_URL_ID__=__MOCK-A_TEST_PAGE-A_ES_URL__ -D __ROOT__=$(BUILD_ROOT)/DOC/mock-a.test -D __VENDOR__=@SRC@/tests/fixtures/MOCK_VENDOR
$(BUILD_ROOT)/DOC/mock-a.test/page-a.mk : @SRC@/tests/fixtures/mock-page.in.html | $$(@D)/ $(BUILD_ROOT)/NAV/mock-a.test/NAVIGATION.m4 $(BUILD_ROOT)/NAV/NAVIGATION-LANDING.m4 ; $(do-generate-deferred-mk)
makefiles-clean :: ; @test -f $(BUILD_ROOT)/DOC/mock-a.test/page-a.mk && rm $(BUILD_ROOT)/DOC/mock-a.test/page-a.mk || true
# -include $(BUILD_ROOT)/DOC/mock-a.test/page-a.mk
assets-clean assets-compress :: | $(BUILD_ROOT)/DOC/mock-a.test/page-a.mk ; $(MAKE) --no-print-directory -f Rules.mk -f $(BUILD_ROOT)/DOC/mock-a.test/page-a.mk SRC=@SRC@ BUILD_ROOT=$(BUILD_ROOT) $@
.PHONY : mock-a-test-build mock-a-test-assets-copy
mock-a-test-assets-copy :: | $(BUILD_ROOT)/DOC/mock-a.test/page-a.mk ; $(MAKE) --no-print-directory -f Rules.mk -f $(BUILD_ROOT)/DOC/mock-a.test/page-a.mk SRC=@SRC@ BUILD_ROOT=$(BUILD_ROOT) assets-copy
mock-a-test-build : $(BUILD_ROOT)/DOC/mock-a.test/page-a.html mock-a-test-assets-copy | $(BUILD_ROOT)/DOC/mock-a.test/page-a.mk
build : mock-a-test-build
makefiles-clean :: ; @test -f MOCK_TARGET.mk && rm MOCK_TARGET.mk || true
